# ==============================================================================
# TEMPLAT ENVIRONMENT VARIABLES — WCC.BYFARIHA
# ==============================================================================
# Salin file ini menjadi .env:
#   copy .env.example .env
#
# Lalu isi dengan Project URL dan anon/publishable key dari Supabase Anda:
#   1. Buka https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
#   2. Salin "Project URL"
#   3. Salin "anon" / "public" key (PUBLISHABLE KEY)
#
# ⚠️ PERINGATAN KEAMANAN SANGAT PENTING:
# JANGAN PERNAH memasukkan "service_role" key ataupun database password di sini!
# File ini dibaca oleh aplikasi frontend, sehingga service_role key TIDAK BOLEH
# diekspos ke publik dalam kondisi apa pun.
# ==============================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here
